#!/usr/bin/env bash
# Refuse commits that break the rules in AGENTS.md.
bash scripts/check.sh || exit 1
# No secrets in commits (keys live in .env.local and Vercel, never in git).
gitleaks git --pre-commit --staged --no-banner --redact --exit-code 1 >/dev/null 2>&1 || { echo "check: a secret is staged for commit (run: gitleaks git --pre-commit --staged --redact)"; exit 1; }
# When the rules themselves change, prove them all again (a check that can't fail protects nothing).
if git diff --cached --name-only | grep -qE '^(scripts/(check|check-test|voice-check)\.(sh|py)|\.githooks/|\.claude/hooks/)'; then
  bash scripts/check-test.sh >/dev/null 2>&1 || { echo "check: scripts/check-test.sh failed; run it to see which rule no longer works"; exit 1; }
fi
